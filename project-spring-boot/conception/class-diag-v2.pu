@startuml

!theme plain
hide empty members
skinparam class {
    BackgroundColor White
    ArrowColor Black
    BorderColor Black
    AttributeIconSize 0
}

' ============================================================
' MODULE 1: IDENTITY & SECURITY (Global Context)
' ============================================================
package "1. Identity & Security" {
    class User {
        +Long id
        +String username
        +String email
        +String passwordHash
        +String fullName
        +UserStatus status
    }

    enum UserStatus {
        PENDING_VERIFICATION
        ACTIVE
        SUSPENDED
    }

    class VerificationToken {
        +Long id
        +String token
        +LocalDateTime expiresAt
    }

    enum TokenType {
        EMAIL_VERIFICATION
        PASSWORD_RESET
    }
}

' ============================================================
' MODULE 2: PROJECT ACCESS (Multi-Tenant Context)
' ============================================================
package "2. Project Context" {
    class Project {
        +Long id
        +String name
        +String key
        +String description
    }

    class ProjectMember {
        +Long id
        +ProjectRole role
        +Date joinedAt
        --
        Represents a User inside a specific Project
    }

    enum ProjectRole {
        PRODUCT_OWNER
        SCRUM_MASTER
        DEVELOPER
    }
}

' ============================================================
' MODULE 3: AGILE PLANNING (Backlog & Requirements)
' ============================================================
package "3. Agile Planning" {
    class ProductBacklog {
        +Long id
    }

    class Epic {
        +Long id
        +String title
        +String description
    }

    class UserStory {
        +Long id
        +String title
        -- Gherkin Format --
        +String asRole
        +String iWant
        +String soThat
        -- Metrics --
        +Integer storyPoints
        +Priority priority
    }

    class AcceptanceScenario {
        +Long id
        +String given
        +String when
        +String then
    }
}

' ============================================================
' MODULE 4: EXECUTION (Sprints & Kanban)
' ============================================================
package "4. Execution Engine" {
    class Sprint {
        +Long id
        +String name
        +Date startDate
        +Date endDate
        +boolean isActive
    }

    class KanbanColumn {
        +Long id
        +String name
        +Integer position
    }

    class Task {
        +Long id
        +String title
        +String description
        +Integer hoursEstimate
    }
}

' ============================================================
' MODULE 5: COLLABORATION & NOTIFICATIONS (New Request)
' ============================================================
package "5. Collaboration & Notifications" {
    class TaskComment {
        +Long id
        +String content
        +LocalDateTime createdAt
        --
        Parses content for @mentions
    }

    class Notification {
        +Long id
        +String message
        +boolean isRead
        +LocalDateTime sentAt
    }

    enum NotificationType {
        TASK_ASSIGNMENT
        COMMENT_TAG
        PROJECT_INVITE
        SPRINT_START
    }
}

' ============================================================
' RELATIONSHIPS
' ============================================================

' --- SECURITY ---
User "1" *-- "0..*" VerificationToken : owns
VerificationToken --> TokenType : type
User --> UserStatus : status

' --- PROJECT MEMBERSHIP ---
User "1" -- "*" ProjectMember : participates as
Project "1" *-- "*" ProjectMember : has members
ProjectMember --> ProjectRole : role

' --- PLANNING ---
Project "1" *-- "1" ProductBacklog : owns
ProductBacklog "1" *-- "*" Epic : contains
Epic "1" *-- "*" UserStory : groups
UserStory "1" *-- "*" AcceptanceScenario : tested by

' --- SPRINT & TEAMS ---
Project "1" *-- "*" Sprint : organizes
' The Sprint Team (Dynamic)
Sprint "*" o-- "*" ProjectMember : <color:blue><b>active_team</b></color>
Sprint "1" o-- "*" UserStory : includes

' --- EXECUTION & BOARD ---
Project "1" *-- "*" KanbanColumn : workflow
UserStory "1" *-- "*" Task : decomposed into
Task "*" --> "1" KanbanColumn : status
' Multi-User Task Assignment
Task "*" --> "*" ProjectMember : <color:blue><b>assigned_to</b></color>

' --- COLLABORATION (New) ---
Task "1" *-- "*" TaskComment : has comments
TaskComment "*" --> "1" ProjectMember : author

' Notification Logic
User "1" *-- "*" Notification : receives
Notification --> NotificationType : type

' The Tagging Logic
TaskComment ..> Notification : <color:red><b>triggers (if @tagged)</b></color>
Notification ..> Task : links to (context)

@enduml
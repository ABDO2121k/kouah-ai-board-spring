@startuml

!theme plain
left to right direction
skinparam packageStyle rectangle

actor "Product Owner" as PO
actor "Scrum Master" as SM
actor "Developer" as DEV
actor "Tester" as TESTER

rectangle "Agile Project Management System" {
    
    ' ============================================================
    ' PROJECT MANAGEMENT (Product Owner)
    ' ============================================================
    package "Project Management" {
        usecase "Create Project" as UC1
        usecase "Add Scrum Master to Project" as UC2
        usecase "View Project Dashboard" as UC3
    }
    
    ' ============================================================
    ' BACKLOG MANAGEMENT (Product Owner primary, Scrum Master supports)
    ' ============================================================
    package "Backlog Management" {
        usecase "Create Epic" as UC5
        usecase "Create User Story" as UC6
        usecase "Assign Epic to Scrum Master" as UC7
        usecase "Prioritize Backlog" as UC8
    }
    
    ' ============================================================
    ' DETAILED PLANNING (Scrum Master)
    ' ============================================================
    package "Sprint Planning" {
        usecase "Define Acceptance Criteria" as UC9
        usecase "Estimate Story Points" as UC10
        usecase "Add User Story to Sprint" as UC11
        usecase "Decompose Story into Tasks" as UC12
    }
    
    ' ============================================================
    ' TEAM MANAGEMENT (Scrum Master)
    ' ============================================================
    package "Team Management" {
        usecase "Add Developer to Team" as UC13
        usecase "Add Tester to Team" as UC14
        usecase "Assign Tasks to Team Members" as UC15
        usecase "Manage Team Capacity" as UC16
    }
    
    ' ============================================================
    ' SPRINT MANAGEMENT (Scrum Master)
    ' ============================================================
    package "Sprint Management" {
        usecase "Create Sprint" as UC17
        usecase "Start Sprint" as UC18
        usecase "Close Sprint" as UC19
        usecase "View Sprint Burndown" as UC20
        usecase "Configure Kanban Board" as UC21
    }
    
    ' ============================================================
    ' TASK EXECUTION (Developer, Tester)
    ' ============================================================
    package "Task Execution" {
        usecase "Update Task Status" as UC22
        usecase "Move Task in Kanban Board" as UC23
        usecase "Estimate Task Hours" as UC24
        usecase "Log Task Progress" as UC25
    }
    
    ' ============================================================
    ' TESTING SPECIFIC (Tester Only)
    ' ============================================================
    package "Quality Assurance" {
        usecase "Move Task to Testing Column" as UC26
        usecase "Execute Test Cases" as UC27
        usecase "Report Bugs" as UC28
        usecase "Validate Acceptance Criteria" as UC29
        usecase "Move Task to Done" as UC30
    }
    
    ' ============================================================
    ' KANBAN BOARD (All Team Members)
    ' ============================================================
    package "Kanban Board" {
        usecase "View Kanban Board" as UC31
        usecase "Set Column Restrictions" as UC32
        usecase "Track Work in Progress (WIP)" as UC33
    }
    
    ' ============================================================
    ' COLLABORATION (All Team Members)
    ' ============================================================
    package "Collaboration" {
        usecase "Add Task Comment" as UC34
        usecase "Mention Team Member (@)" as UC35
        usecase "View Notifications" as UC36
        usecase "Mark Notification as Read" as UC37
    }
    
    ' ============================================================
    ' REPORTING & ANALYTICS (Product Owner, Scrum Master)
    ' ============================================================
    package "Reporting" {
        usecase "Generate Sprint Report" as UC38
        usecase "View Team Velocity" as UC39
        usecase "Export Project Metrics" as UC40
    }
}

' ============================================================
' PRODUCT OWNER RELATIONSHIPS
' ============================================================
PO --> UC1 : creates
PO --> UC2 : assigns
PO --> UC3 : views
PO --> UC5 : creates
PO --> UC6 : creates
PO --> UC7 : assigns to SM
PO --> UC8 : prioritizes
PO --> UC31 : views
PO --> UC36 : receives
PO --> UC37 : manages
PO --> UC38 : generates
PO --> UC39 : analyzes
PO --> UC40 : exports

note right of UC2
  Product Owner can ONLY
  add Scrum Master role
end note

note right of UC7
  Product Owner assigns epics/stories
  to Scrum Master for detailed planning
end note

' ============================================================
' SCRUM MASTER RELATIONSHIPS
' ============================================================
SM --> UC3 : views
SM --> UC6 : creates
SM --> UC9 : defines
SM --> UC10 : estimates
SM --> UC11 : plans
SM --> UC12 : decomposes
SM --> UC13 : adds
SM --> UC14 : adds
SM --> UC15 : assigns
SM --> UC16 : manages
SM --> UC17 : creates
SM --> UC18 : starts
SM --> UC19 : closes
SM --> UC20 : monitors
SM --> UC21 : configures
SM --> UC31 : manages
SM --> UC32 : configures
SM --> UC33 : monitors
SM --> UC34 : adds
SM --> UC35 : uses
SM --> UC36 : receives
SM --> UC37 : manages
SM --> UC38 : generates
SM --> UC39 : analyzes

note right of UC13
  Scrum Master adds and
  manages developers and testers
end note

note right of UC9
  Scrum Master defines detailed
  acceptance criteria for user stories
end note

' ============================================================
' DEVELOPER RELATIONSHIPS
' ============================================================
DEV --> UC22 : updates
DEV --> UC23 : moves (except tester columns)
DEV --> UC24 : estimates
DEV --> UC25 : logs
DEV --> UC31 : views
DEV --> UC33 : respects WIP
DEV --> UC34 : adds
DEV --> UC35 : uses
DEV --> UC36 : receives
DEV --> UC37 : manages

note right of UC23
  Developer CANNOT move tasks
  to columns marked as "testerOnly"
  (Testing, QA Review, Done)
end note

' ============================================================
' TESTER RELATIONSHIPS
' ============================================================
TESTER --> UC22 : updates
TESTER --> UC23 : moves (all columns)
TESTER --> UC24 : estimates
TESTER --> UC25 : logs
TESTER --> UC26 : moves to testing
TESTER --> UC27 : executes
TESTER --> UC28 : reports
TESTER --> UC29 : validates
TESTER --> UC30 : completes
TESTER --> UC31 : views
TESTER --> UC33 : respects WIP
TESTER --> UC34 : adds
TESTER --> UC35 : uses
TESTER --> UC36 : receives
TESTER --> UC37 : manages

note right of UC26
  Only TESTER can move tasks
  to columns with testerOnly=true
  (e.g., Testing, QA Review, Done)
end note

' ============================================================
' USE CASE EXTENSIONS & INCLUDES
' ============================================================
UC6 ..> UC9 : <<extend>>
UC7 ..> UC9 : <<trigger>>
UC11 ..> UC10 : <<include>>
UC12 ..> UC15 : <<include>>
UC23 ..> UC22 : <<include>>
UC26 ..> UC29 : <<include>>
UC35 ..> UC34 : <<extend>>
UC35 ..> UC36 : <<trigger>>

@enduml

@startuml

!theme plain
hide empty members
skinparam class {
    BackgroundColor White
    ArrowColor Black
    BorderColor Black
}

' ==========================================
' MODULE 1: AUTHENTICATION & SECURITY (From your Image)
' ==========================================
package "Security & Identity" {
    class User {
        +Long id
        +String username
        +String email
        +String passwordHash
        +String fullName
        +UserStatus status
        +LocalDateTime createdAt
        +LocalDateTime updatedAt
    }

    enum UserStatus {
        PENDING_VERIFICATION
        ACTIVE
        SUSPENDED
        DELETED
    }

    class VerificationToken {
        +Long id
        +String token
        +TokenType tokenType
        +LocalDateTime expiresAt
    }

    enum TokenType {
        EMAIL_VERIFICATION
        PASSWORD_RESET
    }
}

' ==========================================
' MODULE 2: PROJECT CONTEXT (Multi-Tenant)
' ==========================================
package "Project Access" {
    class Project {
        +Long id
        +String name
        +String key
        +String description
        +LocalDateTime createdDate
    }

    class ProjectMember {
        +Long id
        +Date joinedAt
        +ProjectRole role
        --
        Acts as the bridge between 
        a Global User and a specific Project
    }

    enum ProjectRole {
        PRODUCT_OWNER
        SCRUM_MASTER
        DEVELOPER
    }
}

' ==========================================
' MODULE 3: PLANNING (BACKLOG & BDD)
' ==========================================
package "Agile Requirements" {
    class ProductBacklog {
        +Long id
        +String name
    }

    class Epic {
        +Long id
        +String title
        +String description
    }

    class UserStory {
        +Long id
        +String title
        -- Strict Agile Format --
        +String asRole  (En tant que)
        +String iWant   (Je veux)
        +String soThat  (Afin de)
        -- Metrics --
        +Integer storyPoints
        +MoSCoWPriority priority  'Priority using MoSCoW (MUST/SHOULD/COULD/WON'T)'
    }

    class AcceptanceScenario {
        +Long id
        +String title
        -- BDD / Gherkin --
        +String givenCondition
        +String whenAction
        +String thenResult
    }
}

' Priority enum using MoSCoW technique
enum MoSCoWPriority {
    MUST_HAVE
    SHOULD_HAVE
    COULD_HAVE
    WONT_HAVE
}

' ==========================================
' MODULE 4: EXECUTION (SPRINTS & TASKS)
' ==========================================
package "Agile Execution" {
    class Sprint {
        +Long id
        +String name
        +LocalDateTime startDate
        +LocalDateTime endDate
        +String sprintGoal
        +boolean isActive
    }

    class KanbanColumn {
        +Long id
        +String name (e.g. "Code Review")
        +Integer positionIndex
        +boolean isDoneStatus
    }

    class Task {
        +Long id
        +String title
        +String description
        +Integer estimatedHours
    }
}

' ==========================================
' RELATIONSHIPS
' ==========================================

' 1. SECURITY CONNECTIONS
User "1" *-- "0..*" VerificationToken : possède
User --> UserStatus : status
VerificationToken --> TokenType : type

' 2. PROJECT MEMBERSHIP (The Bridge)
User "1" -- "*" ProjectMember : participates as
Project "1" *-- "*" ProjectMember : has members
ProjectMember --> ProjectRole : role

' 3. PLANNING HIERARCHY
Project "1" *-- "1" ProductBacklog : owns
ProductBacklog "1" *-- "*" Epic : contains
Epic "1" *-- "*" UserStory : groups
UserStory "1" *-- "*" AcceptanceScenario : validated by

' 4. DYNAMIC TEAMS (Teacher Remark)
Project "1" *-- "*" Sprint : organizes
' A sprint has a selected sub-team from the project members
Sprint "*" o-- "*" ProjectMember : <color:red><b>sprint_team (Active Developers)</b></color>

' 5. EXECUTION & KANBAN
Sprint "1" o-- "*" UserStory : includes
UserStory "1" *-- "*" Task : decomposed into

' Dynamic Board Columns
Project "1" *-- "*" KanbanColumn : defines workflow
Task "*" --> "1" KanbanColumn : status

' Multi-User Assignment (Teacher Remark)
Task "*" --> "*" ProjectMember : <color:red><b>assigned_to (Pair Prog/Swarm)</b></color>

@enduml